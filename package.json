{
  "name": "@huberyyang/todo-scripts",
  "type": "module",
  "version": "1.1.1",
  "packageManager": "pnpm@11.23.0",
  "description": "Some public executable scripts",
  "author": "HuberyYang",
  "license": "MIT",
  "homepage": "https://github.com/Hub-yang/todo-scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hub-yang/todo-scripts.git"
  },
  "bugs": {
    "url": "https://github.com/Hub-yang/todo-scripts/issues"
  },
  "keywords": [
    "scripts",
    "node",
    "bash",
    "bin",
    "sh",
    "commitlint"
  ],
  "bin": {
    "hubery": "bin/index.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "build:prod": "nr typecheck && nr lint:fix && nr test && tsdown",
    "preview": "nr build && node bin/index.js commitlint-init",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "release": "nr build:prod && bumpp && npm publish",
    "taze": "npx taze major -r",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@antfu/ni": "^30.5.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1",
    "terminal-link": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0",
    "yocto-spinner": "^1.1.0"
  }
}
